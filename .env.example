
# ==========================================
# POLITIZE-SE AI — CONFIGURAÇÕES
# ==========================================

# Ambiente
APP_NAME="Politize-se AI"
ENVIRONMENT=development

# ==========================================
# OLLAMA — CONEXÃO
# ==========================================

# Endereço do Ollama local
OLLAMA_LOCAL_BASE_URL=http://localhost:11434

# Endereço do Ollama Cloud
OLLAMA_CLOUD_BASE_URL=https://ollama.com

# Obrigatória quando algum modelo utilizar Cloud
OLLAMA_API_KEY=

# ==========================================
# ASSISTENTE PRINCIPAL
# ==========================================

# Provider: local | cloud
OLLAMA_PROVIDER=local

# Nome do modelo disponível no provider escolhido
LLM_MODEL=gemma4:12b

LLM_TEMPERATURE=0.3
LLM_TOP_P=0.9
LLM_NUM_PREDICT=1200

# ==========================================
# GERADOR DE ÍNDICE SEMÂNTICO
# ==========================================

# Provider: local | cloud
SEMANTIC_INDEX_PROVIDER=local

# Nome do modelo disponível no provider escolhido
SEMANTIC_INDEX_MODEL=gemma4:12b

SEMANTIC_INDEX_TEMPERATURE=0.1
SEMANTIC_INDEX_TOP_P=0.9
SEMANTIC_INDEX_NUM_PREDICT=4096
SEMANTIC_INDEX_NUM_CTX=8192

# ==========================================
# PROMPT
# ==========================================

SYSTEM_PROMPT_FILE=system_prompt_v1.md

# ==========================================
# EMBEDDINGS
# ==========================================

RAG_EMBEDDING_PROVIDER=auto
RAG_EMBEDDING_MODEL=nomic-embed-text

# ==========================================
# CHROMADB
# ==========================================

CHROMA_PERSIST_DIRECTORY=data/chroma_db
CHROMA_COLLECTION_PREFIX=politizese

# ==========================================
# DOCUMENTOS
# ==========================================

DOCUMENTS_DIRECTORY=knowledge
